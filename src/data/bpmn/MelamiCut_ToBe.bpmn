<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_MelamiCut_ToBe" targetNamespace="http://bizagi.com/bpmn20">
  <bpmn:collaboration id="Collaboration_Process_MelamiCut_ToBe">
    <bpmn:participant id="Participant_Process_MelamiCut_ToBe" name="MelamiCut S.A.C." processRef="Process_MelamiCut_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_MelamiCut_ToBe" name="MelamiCut S.A.C. - Proceso To-Be" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_MelamiCut_ToBe">
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_0" name="Cliente">
        <bpmn:flowNodeRef>Start_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Solicitar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recibir_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_1" name="Ventas">
        <bpmn:flowNodeRef>Task_Registrar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoDisp_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_2" name="Almacen">
        <bpmn:flowNodeRef>Task_Verificar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Disp_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_3" name="Caja">
        <bpmn:flowNodeRef>Task_Pago_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_4" name="Produccion">
        <bpmn:flowNodeRef>Task_Revisar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cortar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Calidad_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Corregir_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_5" name="Sistema">
        <bpmn:flowNodeRef>Task_Validar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orden_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Incidencia_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Listo_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_MelamiCut_ToBe_6" name="Software de optimizacion">
        <bpmn:flowNodeRef>Task_Patron_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ToBe" name="Inicio solicitud">
      <bpmn:outgoing>G1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Solicitar_ToBe" name="Solicitar pedido">
      <bpmn:incoming>G1</bpmn:incoming>
      <bpmn:outgoing>G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Registrar_ToBe" name="Registrar pedido">
      <bpmn:incoming>G2</bpmn:incoming>
      <bpmn:outgoing>G3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Validar_ToBe" name="Validar informacion">
      <bpmn:incoming>G3</bpmn:incoming>
      <bpmn:outgoing>G4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificar_ToBe" name="Verificar disponibilidad">
      <bpmn:incoming>G4</bpmn:incoming>
      <bpmn:outgoing>G5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Disp_ToBe" name="Hay material?">
      <bpmn:incoming>G5</bpmn:incoming>
      <bpmn:outgoing>G6no</bpmn:outgoing>
      <bpmn:outgoing>G6si</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Informar_ToBe" name="Informar no disponible">
      <bpmn:incoming>G6no</bpmn:incoming>
      <bpmn:outgoing>G7no</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_NoDisp_ToBe" name="Fin no disponible">
      <bpmn:incoming>G7no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Pago_ToBe" name="Registrar pago">
      <bpmn:incoming>G6si</bpmn:incoming>
      <bpmn:outgoing>G8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Confirmar_ToBe" name="Confirmar pedido">
      <bpmn:incoming>G8</bpmn:incoming>
      <bpmn:outgoing>G9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Orden_ToBe" name="Generar orden de produccion">
      <bpmn:incoming>G9</bpmn:incoming>
      <bpmn:outgoing>G10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Revisar_ToBe" name="Revisar orden">
      <bpmn:incoming>G10</bpmn:incoming>
      <bpmn:outgoing>G11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Patron_ToBe" name="Generar patron">
      <bpmn:incoming>G11</bpmn:incoming>
      <bpmn:outgoing>G12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cortar_ToBe" name="Realizar cortes">
      <bpmn:incoming>G12</bpmn:incoming>
      <bpmn:incoming>G16loop</bpmn:incoming>
      <bpmn:outgoing>G13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Calidad_ToBe" name="Control correcto?">
      <bpmn:incoming>G13</bpmn:incoming>
      <bpmn:outgoing>G14bad</bpmn:outgoing>
      <bpmn:outgoing>G14ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Incidencia_ToBe" name="Registrar incidencia">
      <bpmn:incoming>G14bad</bpmn:incoming>
      <bpmn:outgoing>G15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Corregir_ToBe" name="Corregir corte">
      <bpmn:incoming>G15</bpmn:incoming>
      <bpmn:outgoing>G16loop</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Listo_ToBe" name="Listo para entrega">
      <bpmn:incoming>G14ok</bpmn:incoming>
      <bpmn:outgoing>G17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Recibir_ToBe" name="Recibir pedido">
      <bpmn:incoming>G17</bpmn:incoming>
      <bpmn:outgoing>G18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ToBe" name="Entregado">
      <bpmn:incoming>G18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="G1" sourceRef="Start_ToBe" targetRef="Task_Solicitar_ToBe" />
    <bpmn:sequenceFlow id="G2" sourceRef="Task_Solicitar_ToBe" targetRef="Task_Registrar_ToBe" />
    <bpmn:sequenceFlow id="G3" sourceRef="Task_Registrar_ToBe" targetRef="Task_Validar_ToBe" />
    <bpmn:sequenceFlow id="G4" sourceRef="Task_Validar_ToBe" targetRef="Task_Verificar_ToBe" />
    <bpmn:sequenceFlow id="G5" sourceRef="Task_Verificar_ToBe" targetRef="Gw_Disp_ToBe" />
    <bpmn:sequenceFlow id="G6no" sourceRef="Gw_Disp_ToBe" targetRef="Task_Informar_ToBe" name="No" />
    <bpmn:sequenceFlow id="G7no" sourceRef="Task_Informar_ToBe" targetRef="End_NoDisp_ToBe" />
    <bpmn:sequenceFlow id="G6si" sourceRef="Gw_Disp_ToBe" targetRef="Task_Pago_ToBe" name="Si" />
    <bpmn:sequenceFlow id="G8" sourceRef="Task_Pago_ToBe" targetRef="Task_Confirmar_ToBe" />
    <bpmn:sequenceFlow id="G9" sourceRef="Task_Confirmar_ToBe" targetRef="Task_Orden_ToBe" />
    <bpmn:sequenceFlow id="G10" sourceRef="Task_Orden_ToBe" targetRef="Task_Revisar_ToBe" />
    <bpmn:sequenceFlow id="G11" sourceRef="Task_Revisar_ToBe" targetRef="Task_Patron_ToBe" />
    <bpmn:sequenceFlow id="G12" sourceRef="Task_Patron_ToBe" targetRef="Task_Cortar_ToBe" />
    <bpmn:sequenceFlow id="G13" sourceRef="Task_Cortar_ToBe" targetRef="Gw_Calidad_ToBe" />
    <bpmn:sequenceFlow id="G14bad" sourceRef="Gw_Calidad_ToBe" targetRef="Task_Incidencia_ToBe" name="Incorrecto" />
    <bpmn:sequenceFlow id="G15" sourceRef="Task_Incidencia_ToBe" targetRef="Task_Corregir_ToBe" />
    <bpmn:sequenceFlow id="G16loop" sourceRef="Task_Corregir_ToBe" targetRef="Task_Cortar_ToBe" name="Reintentar" />
    <bpmn:sequenceFlow id="G14ok" sourceRef="Gw_Calidad_ToBe" targetRef="Task_Listo_ToBe" name="Correcto" />
    <bpmn:sequenceFlow id="G17" sourceRef="Task_Listo_ToBe" targetRef="Task_Recibir_ToBe" />
    <bpmn:sequenceFlow id="G18" sourceRef="Task_Recibir_ToBe" targetRef="End_ToBe" />
  </bpmn:process>
