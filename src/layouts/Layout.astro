---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Análisis As-Is / To-Be y Modelamiento BPMN · MelamiCut S.A.C.',
	description = 'Estudio de reingeniería de procesos y madurez de datos para la gestión de pedidos y corte de melamina (CMMI & DMM)',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#fafaf9] text-neutral-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen antialiased selection:bg-neutral-800 selection:text-white text-neutral-800 font-sans">
		<!-- Top Progress Indicator -->
		<div id="progress-bar" class="fixed top-0 left-0 h-1 bg-neutral-800 z-50 transition-all duration-75 w-0"></div>

		<!-- Minimal Header -->
		<header class="border-b border-neutral-200 bg-white/90 backdrop-blur sticky top-0 z-40">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between">
				<div class="flex items-center gap-2 text-xs font-medium text-neutral-600">
					<span class="font-bold text-neutral-900">CMMI & DMM</span>
					<span class="text-neutral-300">/</span>
					<span class="text-neutral-600 truncate">MelamiCut S.A.C.</span>
				</div>

				<nav class="flex items-center gap-4 text-xs">
					<a href="#sec-8" class="text-neutral-600 hover:text-neutral-950 transition-colors">BPMN As-Is</a>
					<a href="#sec-12" class="text-neutral-600 hover:text-neutral-950 transition-colors">BPMN To-Be</a>
					<a href="#sec-evidencias" class="text-neutral-800 font-medium hover:text-neutral-950 underline underline-offset-4 decoration-neutral-300">Evidencias</a>
				</nav>
			</div>
		</header>

		<!-- Content Slot -->
		<slot />

		<!-- Minimal Footer -->
		<footer class="border-t border-neutral-200 bg-white py-8 mt-16 text-xs text-neutral-500">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
				<span>Caso de Estudio: MelamiCut S.A.C.</span>
				<span>Gestión de Procesos (CMMI) y Datos (DMM)</span>
			</div>
		</footer>

		<script>
			window.addEventListener('scroll', () => {
				const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = (winScroll / height) * 100;
				const bar = document.getElementById('progress-bar');
				if (bar) bar.style.width = scrolled + '%';
			});
		</script>
	</body>
</html>
