---
import asIsRaw from '../data/bpmn/FerZur_AsIs.bpmn?raw';
import toBeRaw from '../data/bpmn/FerZur_ToBe.bpmn?raw';

interface Props {
	type: 'as-is' | 'to-be';
	title: string;
}

const { type, title } = Astro.props;
const isAsIs = type === 'as-is';
const rawXml = isAsIs ? asIsRaw : toBeRaw;
const viewerId = `bpmn-viewer-${type}`;
---

<div class="my-8 rounded-lg border border-neutral-200 bg-white overflow-hidden text-neutral-800">
	<!-- Header Bar -->
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 bg-neutral-50 border-b border-neutral-200">
		<div>
			<span class="text-[11px] font-semibold text-neutral-500 uppercase tracking-wider block">
				{isAsIs ? 'Diagrama integrado · Estado Actual' : 'Diagrama integrado · Estado Propuesto'}
			</span>
			<h4 class="text-base font-bold text-neutral-900">{title}</h4>
		</div>

		<!-- Interactive controls -->
		<div class="flex items-center gap-1.5 text-xs">
			<button
				type="button"
				class="zoom-in-btn px-2.5 py-1 bg-white border border-neutral-300 rounded hover:bg-neutral-100 text-neutral-700 transition-colors"
				data-target={viewerId}
				title="Acercar"
			>
				+
			</button>
			<button
				type="button"
				class="zoom-out-btn px-2.5 py-1 bg-white border border-neutral-300 rounded hover:bg-neutral-100 text-neutral-700 transition-colors"
				data-target={viewerId}
				title="Alejar"
			>
				-
			</button>
			<button
				type="button"
				class="reset-zoom-btn px-3 py-1 bg-white border border-neutral-300 rounded hover:bg-neutral-100 text-neutral-700 transition-colors"
				data-target={viewerId}
				title="Ajustar a la pantalla"
			>
				Centrar
			</button>
		</div>
	</div>

	<!-- Interactive BPMN Canvas (bpmn-js) -->
	<div
		id={viewerId}
		class="bpmn-canvas w-full h-[460px] bg-[#fdfdfd] relative cursor-grab active:cursor-grabbing border-b border-neutral-100"
		data-xml={rawXml}
	>
		<div class="absolute inset-0 flex items-center justify-center text-xs text-neutral-400 pointer-events-none loading-indicator">
			Cargando diagrama BPMN interactivo...
		</div>
	</div>

	<!-- Structured Steps Summary (Accessible fallback & quick reference) -->
	<div class="p-4 bg-neutral-50/50">
		<details class="text-xs group">
			<summary class="cursor-pointer font-medium text-neutral-700 hover:text-neutral-950 py-1 flex items-center justify-between select-none">
				<span>Ver desglose de actividades y carriles</span>
				<span class="text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
			</summary>
			<div class="mt-3 pt-3 border-t border-neutral-200">
				{isAsIs ? (
					<div class="space-y-1.5 text-neutral-600">
						<p><strong class="text-neutral-800">1. Cliente:</strong> Solicita productos o servicio de corte.</p>
						<p><strong class="text-neutral-800">2. Ventas:</strong> Registra el pedido en la PC principal con SQLite local.</p>
						<p><strong class="text-neutral-800">3. Almacén:</strong> Verifica disponibilidad de material. Si no hay stock, informa a ventas.</p>
						<p><strong class="text-neutral-800">4. Caja:</strong> Registra el pago del cliente tras confirmación.</p>
						<p><strong class="text-neutral-800">5. Producción:</strong> Revisa medidas e ingresa datos manualmente al software.</p>
						<p><strong class="text-neutral-800">6. CutList Optimizer:</strong> Genera patrón de distribución de cortes.</p>
						<p><strong class="text-neutral-800">7. Taller:</strong> Realiza los cortes físicos y pasa por control de calidad.</p>
						<p><strong class="text-neutral-800">8. Control de Calidad:</strong> Si es incorrecto se corrige; si es correcto, se actualiza y se entrega.</p>
					</div>
				) : (
					<div class="space-y-1.5 text-neutral-600">
						<p><strong class="text-neutral-800">1. Cliente:</strong> Realiza la solicitud con dimensiones y tapacantos requeridos.</p>
						<p><strong class="text-neutral-800">2. Ventas & Sistema:</strong> Registro único en la plataforma centralizada con validación inmediata.</p>
						<p><strong class="text-neutral-800">3. Almacén:</strong> Comprobación de inventario en línea y notificación automática.</p>
						<p><strong class="text-neutral-800">4. Caja:</strong> Registro del pago y paso a estado CONFIRMADO.</p>
						<p><strong class="text-neutral-800">5. Sistema:</strong> Genera automáticamente la Orden de Producción paramétrica vinculada.</p>
						<p><strong class="text-neutral-800">6. Optimización:</strong> Reutilización directa de medidas en CutList sin redigitación manual.</p>
						<p><strong class="text-neutral-800">7. Taller & Calidad:</strong> Ejecución de corte, inspección formal con registro de incidencias y estado LISTO.</p>
						<p><strong class="text-neutral-800">8. Despacho:</strong> Entrega conforme y transición al estado final ENTREGADO.</p>
					</div>
				)}
			</div>
		</details>
	</div>
</div>

<script>
	import BpmnViewer from 'bpmn-js/dist/bpmn-navigated-viewer.production.min.js';

	// Initialize all BPMN viewers on the page
	document.querySelectorAll<HTMLElement>('.bpmn-canvas').forEach(async (canvasElem) => {
		const xml = canvasElem.getAttribute('data-xml');
		const loading = canvasElem.querySelector('.loading-indicator');
		if (!xml) return;

		try {
			const viewer = new BpmnViewer({
				container: canvasElem,
				keyboard: { bindTo: window }
			});

			await viewer.importXML(xml);
			const canvas = viewer.get('canvas');
			canvas.zoom('fit-viewport');
			if (loading) loading.remove();

			// Bind toolbar zoom buttons
			const targetId = canvasElem.id;
			const zoomInBtn = document.querySelector(`.zoom-in-btn[data-target="${targetId}"]`);
			const zoomOutBtn = document.querySelector(`.zoom-out-btn[data-target="${targetId}"]`);
			const resetZoomBtn = document.querySelector(`.reset-zoom-btn[data-target="${targetId}"]`);

			zoomInBtn?.addEventListener('click', () => {
				canvas.zoom(canvas.zoom() * 1.25);
			});

			zoomOutBtn?.addEventListener('click', () => {
				canvas.zoom(canvas.zoom() * 0.8);
			});

			resetZoomBtn?.addEventListener('click', () => {
				canvas.zoom('fit-viewport');
			});
		} catch (err) {
			console.error('Error importando XML BPMN:', err);
			if (loading) {
				loading.textContent = 'No se pudo renderizar el visor interactivo de BPMN.';
			}
		}
	});
</script>
