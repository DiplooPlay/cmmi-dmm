---
// Índice de navegación del caso de estudio
const sections = [
	{ id: "sec-1", num: "1", title: "Introducción" },
	{ id: "sec-2", num: "2", title: "Descripción de la empresa" },
	{ id: "sec-3", num: "3", title: "Procesos de la empresa (CMMI nivel 1)" },
	{ id: "sec-4", num: "4", title: "Proceso 1: Gestión de pedido" },
	{ id: "sec-5", num: "5", title: "Proceso 2: Gestión de inventario" },
	{ id: "sec-6", num: "6", title: "Resumen de debilidades" },
	{ id: "sec-7", num: "7", title: "Análisis: Gestión de pedido (As-Is / CMMI 1 / To-Be)" },
	{ id: "sec-8", num: "8", title: "Análisis: Gestión de inventario (As-Is / CMMI 1 / To-Be)" },
	{ id: "sec-evidencias", num: "9", title: "Evidencias del proyecto" }
];
---

<nav class="my-8 p-5 bg-neutral-50 rounded-lg border border-neutral-200 text-neutral-800">
	<div class="flex items-center justify-between mb-3 pb-2 border-b border-neutral-200">
		<span class="text-xs font-semibold uppercase tracking-wider text-neutral-600">Índice del documento</span>
		<span class="text-xs text-neutral-400">9 Secciones</span>
	</div>
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-xs">
		{sections.map((s) => (
			<a
				href={`#${s.id}`}
				class="text-neutral-600 hover:text-neutral-950 py-1 transition-colors flex items-baseline gap-2 group"
			>
				<span class="text-neutral-400 group-hover:text-neutral-700 w-5 shrink-0 text-right font-mono">{s.num}.</span>
				<span class="truncate hover:underline underline-offset-2">{s.title}</span>
			</a>
		))}
	</div>
</nav>
