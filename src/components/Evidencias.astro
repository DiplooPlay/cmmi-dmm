---
import fs from 'node:fs';
import path from 'node:path';

interface EvidenciaSlot {
	id: string;
	filenameBase: string;
	title: string;
	description: string;
}

const assignedSlots: EvidenciaSlot[] = [
	{
		id: "ev-1",
		filenameBase: "evidencia1",
		title: "1. Levantamiento de información y entrevista inicial",
		description: "Reunión con el personal de ventas y administración de MelamiCut S.A.C."
	},
	{
		id: "ev-2",
		filenameBase: "evidencia2",
		title: "2. Operación con CutList Optimizer y registro local",
		description: "Captura del flujo actual de registro manual de piezas y optimización."
	},
	{
		id: "ev-3",
		filenameBase: "evidencia3",
		title: "3. Taller, seccionadora y área de producción",
		description: "Área física de corte de melamina y colocación de tapacantos."
	},
	{
		id: "ev-4",
		filenameBase: "evidencia4",
		title: "4. Modelamiento de procesos en Bizagi Modeler",
		description: "Sesión de diagramación y validación de los modelos As-Is y To-Be."
	},
	{
		id: "ev-5",
		filenameBase: "evidencia5",
		title: "5. Control de calidad y medición de piezas",
		description: "Verificación de medidas, escuadras y tolerancias en el taller."
	},
	{
		id: "ev-6",
		filenameBase: "evidencia6",
		title: "6. Validación de resultados del estudio",
		description: "Revisión final de métricas y alineamiento con los criterios CMMI y DMM."
	}
];

const evidenciasDir = path.join(process.cwd(), 'public', 'evidencias');
const supportedExts = ['.jpg', '.jpeg', '.png', '.webp', '.svg'];

// Resolve each slot checking if file exists on disk
const resolvedSlots = assignedSlots.map((slot) => {
	let foundFile: string | null = null;
	if (fs.existsSync(evidenciasDir)) {
		for (const ext of supportedExts) {
			const candidate = `${slot.filenameBase}${ext}`;
			if (fs.existsSync(path.join(evidenciasDir, candidate))) {
				foundFile = candidate;
				break;
			}
		}
	}
	return {
		...slot,
		fileUrl: foundFile ? `/evidencias/${foundFile}` : null,
		assignedFilename: `${slot.filenameBase}.jpg`
	};
});

// Detect any extra images added to public/evidencias
let extraImages: { filename: string; url: string }[] = [];
if (fs.existsSync(evidenciasDir)) {
	const allFiles = fs.readdirSync(evidenciasDir).filter(f => !f.startsWith('.'));
	extraImages = allFiles
		.filter(f => {
			const parsed = path.parse(f);
			const baseName = parsed.name.toLowerCase();
			return !assignedSlots.some(s => s.filenameBase.toLowerCase() === baseName);
		})
		.map(f => ({
			filename: f,
			url: `/evidencias/${f}`
		}));
}

const preguntasEntrevista = [
	{
		num: 1,
		pregunta: "¿Cómo se distribuyen actualmente las responsabilidades operativas entre las áreas de ventas, caja, almacén y taller de corte?"
	},
	{
		num: 2,
		pregunta: "Desde que un cliente llega con su proyecto hasta que recibe el material cortado, ¿cuáles son los pasos que sigue actualmente el pedido?"
	},
	{
		num: 3,
		pregunta: "Cuando un cliente solicita cortes personalizados, ¿dónde y cómo se registran las dimensiones, el grosor, el tipo de tablero y los requerimientos de tapacanto?"
	},
	{
		num: 4,
		pregunta: "¿Cuántas personas o equipos pueden registrar o modificar pedidos simultáneamente?"
	},
	{
		num: 5,
		pregunta: "Si un cliente solicita modificar las medidas o características de sus piezas después de haber registrado el pedido, ¿cómo se gestiona actualmente el cambio y qué problemas puede ocasionar?"
	},
	{
		num: 6,
		pregunta: "¿Cómo verifica el personal que existe stock físico de las planchas de melamina necesarias antes de cobrar o procesar un pedido?"
	},
	{
		num: 7,
		pregunta: "¿Qué sucede cuando una plancha requerida no está disponible o presenta algún defecto al momento de realizar el corte?"
	},
	{
		num: 8,
		pregunta: "¿En qué momento interviene el área de caja y qué documento, comprobante o autorización indica al personal de producción que puede iniciar el trabajo?"
	},
	{
		num: 9,
		pregunta: "¿Cómo recibe actualmente el encargado de producción las medidas y especificaciones de las piezas que debe cortar?"
	},
	{
		num: 10,
		pregunta: "¿Cómo se realiza el ingreso de las dimensiones de las piezas en el software CutList Optimizer?"
	},
	{
		num: 11,
		pregunta: "¿Cuánto tiempo y esfuerzo requiere transcribir manualmente los datos de cada pedido al software de optimización?"
	},
	{
		num: 12,
		pregunta: "¿Con qué frecuencia se producen errores al transcribir las medidas y qué consecuencias generan en el desperdicio de material, el tiempo de trabajo o la necesidad de repetir cortes?"
	},
	{
		num: 13,
		pregunta: "¿Cómo se realiza actualmente la revisión de calidad de las piezas antes de empaquetarlas o entregarlas al cliente?"
	},
	{
		num: 14,
		pregunta: "Si una pieza se corta incorrectamente, ¿cómo se registra el incidente y cómo se gestiona su reposición?"
	},
	{
		num: 15,
		pregunta: "Si un cliente consulta sobre el estado de su pedido, ¿cómo determina el personal en qué etapa se encuentra, por ejemplo, pendiente, en optimización, en corte o terminado?"
	},
	{
		num: 16,
		pregunta: "¿Cómo se informa al área de atención o ventas que un pedido ya terminó de ser cortado y está listo para ser entregado al cliente?"
	},
	{
		num: 17,
		pregunta: "¿Qué comprobante o constancia se utiliza actualmente para confirmar que el cliente recibió su pedido completo y conforme?"
	},
	{
		num: 18,
		pregunta: "La base de datos actual funciona en una computadora principal. ¿Qué limitaciones o riesgos representa para el negocio depender de un único equipo?"
	},
	{
		num: 19,
		pregunta: "¿Qué procedimiento se sigue si la computadora principal presenta una falla, se daña o deja de estar disponible?"
	},
	{
		num: 20,
		pregunta: "¿Con qué frecuencia se realizan copias de seguridad de la base de datos y dónde se almacenan actualmente?"
	},
	{
		num: 21,
		pregunta: "¿Qué información considera más importante conservar y consultar para poder hacer seguimiento a un pedido desde su registro hasta su entrega?"
	},
	{
		num: 22,
		pregunta: "¿Qué problemas o retrasos se presentan con mayor frecuencia durante todo el proceso de venta, corte y entrega de los pedidos?"
	},
	{
		num: 23,
		pregunta: "¿Qué actividades del proceso considera que actualmente requieren más tiempo o trabajo manual?"
	},
	{
		num: 24,
		pregunta: "¿Qué información le gustaría poder consultar de manera inmediata y que actualmente resulta difícil de obtener?"
	}
];
---

<section id="sec-evidencias" class="my-14 pt-6 border-t border-neutral-200 scroll-mt-16">
	<div class="mb-6">
		<h2 class="text-xl sm:text-2xl font-serif font-bold text-neutral-900 mb-2">
			16. Evidencias del Proyecto
		</h2>
		<p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
			Registro fotográfico y capturas de validación correspondientes al estudio de campo en MelamiCut S.A.C.
		</p>
	</div>

	<!-- Slots Grid -->
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
		{resolvedSlots.map((item) => (
			<div class="rounded-lg border border-neutral-200 bg-white overflow-hidden flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
				{item.fileUrl ? (
					<div>
						<div class="relative bg-neutral-100 aspect-video overflow-hidden border-b border-neutral-100 group">
							<img
								src={item.fileUrl}
								alt={item.title}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 cursor-pointer"
								loading="lazy"
								onclick={`window.open('${item.fileUrl}', '_blank')`}
							/>
							<span class="absolute top-2 right-2 px-2 py-0.5 rounded bg-emerald-700 text-white text-[10px] font-medium shadow">
								✓ Registro fotográfico
							</span>
						</div>
						<div class="p-4">
							<h3 class="text-sm font-bold text-neutral-900 mb-1">{item.title}</h3>
							<p class="text-xs text-neutral-600">{item.description}</p>
							{item.id === 'ev-1' && (
								<a href="#guia-entrevista" class="inline-flex items-center gap-1.5 mt-2.5 text-xs font-semibold text-neutral-800 hover:text-neutral-950 underline underline-offset-2">
									<span>Ver guía de entrevista (24 preguntas)</span>
									<span>↓</span>
								</a>
							)}
						</div>
					</div>
				) : (
					<div>
						<div class="aspect-video bg-neutral-50/80 border-b border-dashed border-neutral-200 flex flex-col items-center justify-center p-6 text-center text-neutral-400">
							<div class="w-12 h-12 rounded-full bg-neutral-100 flex items-center justify-center mb-2 text-neutral-400">
								<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
							</div>
							<span class="text-xs font-medium text-neutral-600 mb-0.5">
								Registro fotográfico
							</span>
							<span class="text-[11px] text-neutral-400">
								Pendiente de anexar
							</span>
						</div>
						<div class="p-4">
							<h3 class="text-sm font-bold text-neutral-900 mb-1">{item.title}</h3>
							<p class="text-xs text-neutral-600">{item.description}</p>
							{item.id === 'ev-1' && (
								<a href="#guia-entrevista" class="inline-flex items-center gap-1.5 mt-2.5 text-xs font-semibold text-neutral-800 hover:text-neutral-950 underline underline-offset-2">
									<span>Ver guía de entrevista (24 preguntas)</span>
									<span>↓</span>
								</a>
							)}
						</div>
					</div>
				)}
			</div>
		))}

		{extraImages.map((extra) => (
			<div class="rounded-lg border border-neutral-200 bg-white overflow-hidden flex flex-col justify-between shadow-sm">
				<div>
					<div class="relative bg-neutral-100 aspect-video overflow-hidden border-b border-neutral-100">
						<img
							src={extra.url}
							alt={extra.filename}
							class="w-full h-full object-cover cursor-pointer"
							loading="lazy"
							onclick={`window.open('${extra.url}', '_blank')`}
						/>
						<span class="absolute top-2 right-2 px-2 py-0.5 rounded bg-blue-700 text-white text-[10px] font-medium shadow">
							Evidencia adicional
						</span>
					</div>
					<div class="p-4">
						<h3 class="text-sm font-bold text-neutral-900 mb-1">{extra.filename}</h3>
						<p class="text-xs text-neutral-500">Evidencia fotográfica complementaria</p>
					</div>
				</div>
			</div>
		))}
	</div>

	<!-- Instrumento de Levantamiento: Guía de Entrevista -->
	<div id="guia-entrevista" class="mt-12 rounded-xl border border-neutral-200 bg-white p-5 sm:p-7 shadow-sm scroll-mt-20">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-neutral-200">
			<div>
				<div class="flex items-center gap-2 mb-1.5">
					<span class="px-2 py-0.5 rounded bg-neutral-100 border border-neutral-200 text-neutral-700 font-mono text-[11px] font-semibold uppercase tracking-wider">
						Instrumento de campo
					</span>
					<span class="text-xs text-neutral-500">24 preguntas estructuradas</span>
				</div>
				<h3 class="text-lg sm:text-xl font-serif font-bold text-neutral-900">
					Entrevista del Proceso — MelamiCut S.A.C.
				</h3>
			</div>
		</div>

		<!-- Meta información del instrumento -->
		<div class="my-5 p-4 rounded-lg bg-neutral-50 border border-neutral-200 space-y-2 text-xs sm:text-sm text-neutral-700">
			<div>
				<strong class="text-neutral-900 font-semibold">Objetivo:</strong>
				<span class="text-neutral-600 ml-1">Relevar en detalle la operativa actual (As-Is), identificar las causas raíz de las principales dificultades operativas y validar los requerimientos de la solución propuesta (To-Be).</span>
			</div>
			<div>
				<strong class="text-neutral-900 font-semibold">Entrevistado:</strong>
				<span class="text-neutral-600 ml-1">Administrador / Dueño / Responsable Operativo General</span>
			</div>
		</div>

		<!-- Listado de preguntas estructuradas -->
		<div>
			<h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-4 pb-1 border-b border-neutral-100">
				Cuestionario estructurado de levantamiento y validación
			</h4>
			<ol class="space-y-2 text-xs sm:text-sm text-neutral-800">
				{preguntasEntrevista.map((item) => (
					<li class="flex items-start gap-3 p-2.5 rounded hover:bg-neutral-50/80 transition-colors">
						<span class="font-mono text-neutral-400 font-semibold w-6 shrink-0 text-right pt-0.5">
							{String(item.num).padStart(2, '0')}.
						</span>
						<span class="text-neutral-700 leading-relaxed">
							{item.pregunta}
						</span>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>
