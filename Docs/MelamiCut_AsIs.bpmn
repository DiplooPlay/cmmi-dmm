<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_FerZur_AsIs" targetNamespace="http://bizagi.com/bpmn20">
  <bpmn:collaboration id="Collaboration_Process_FerZur_AsIs">
    <bpmn:participant id="Participant_Process_FerZur_AsIs" name="FerZur S.A.C." processRef="Process_FerZur_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FerZur_AsIs" name="FerZur S.A.C. - Proceso As-Is" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_FerZur_AsIs">
      <bpmn:lane id="Lane_Process_FerZur_AsIs_0" name="Cliente">
        <bpmn:flowNodeRef>Start_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Solicitar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recibir_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_1" name="Ventas">
        <bpmn:flowNodeRef>Task_Registrar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoDisp_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Comunicar_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_2" name="Almacen">
        <bpmn:flowNodeRef>Task_Verificar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Disp_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_3" name="Caja">
        <bpmn:flowNodeRef>Task_Pago_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_4" name="Produccion">
        <bpmn:flowNodeRef>Task_Revisar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ingresar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cortar_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Calidad_AsIs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Corregir_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_5" name="Sistema">
        <bpmn:flowNodeRef>Task_Actualizar_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_FerZur_AsIs_6" name="Software de optimizacion">
        <bpmn:flowNodeRef>Task_Patron_AsIs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AsIs" name="Inicio solicitud">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Solicitar_AsIs" name="Solicitar pedido">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Registrar_AsIs" name="Registrar pedido">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Verificar_AsIs" name="Verificar disponibilidad">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Disp_AsIs" name="Hay material?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5no</bpmn:outgoing>
      <bpmn:outgoing>F5si</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Informar_AsIs" name="Informar no disponible">
      <bpmn:incoming>F5no</bpmn:incoming>
      <bpmn:outgoing>F6no</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_NoDisp_AsIs" name="Fin no disponible">
      <bpmn:incoming>F6no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Confirmar_AsIs" name="Confirmar pedido">
      <bpmn:incoming>F5si</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pago_AsIs" name="Registrar pago">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Revisar_AsIs" name="Revisar medidas">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ingresar_AsIs" name="Ingresar medidas manualmente">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Patron_AsIs" name="Generar patron de corte">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cortar_AsIs" name="Realizar cortes">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F14loop</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Calidad_AsIs" name="Piezas correctas?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13bad</bpmn:outgoing>
      <bpmn:outgoing>F13ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Corregir_AsIs" name="Corregir corte">
      <bpmn:incoming>F13bad</bpmn:incoming>
      <bpmn:outgoing>F14loop</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Actualizar_AsIs" name="Actualizar pedido">
      <bpmn:incoming>F13ok</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Comunicar_AsIs" name="Comunicar al cliente">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Recibir_AsIs" name="Recibir pedido">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_AsIs" name="Pedido entregado">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_AsIs" targetRef="Task_Solicitar_AsIs" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Solicitar_AsIs" targetRef="Task_Registrar_AsIs" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Registrar_AsIs" targetRef="Task_Verificar_AsIs" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Verificar_AsIs" targetRef="Gw_Disp_AsIs" />
    <bpmn:sequenceFlow id="F5no" sourceRef="Gw_Disp_AsIs" targetRef="Task_Informar_AsIs" name="No" />
    <bpmn:sequenceFlow id="F6no" sourceRef="Task_Informar_AsIs" targetRef="End_NoDisp_AsIs" />
    <bpmn:sequenceFlow id="F5si" sourceRef="Gw_Disp_AsIs" targetRef="Task_Confirmar_AsIs" name="Si" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Confirmar_AsIs" targetRef="Task_Pago_AsIs" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Pago_AsIs" targetRef="Task_Revisar_AsIs" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Revisar_AsIs" targetRef="Task_Ingresar_AsIs" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Ingresar_AsIs" targetRef="Task_Patron_AsIs" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Patron_AsIs" targetRef="Task_Cortar_AsIs" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Cortar_AsIs" targetRef="Gw_Calidad_AsIs" />
    <bpmn:sequenceFlow id="F13bad" sourceRef="Gw_Calidad_AsIs" targetRef="Task_Corregir_AsIs" name="Incorrecto" />
    <bpmn:sequenceFlow id="F14loop" sourceRef="Task_Corregir_AsIs" targetRef="Task_Cortar_AsIs" name="Reintentar" />
    <bpmn:sequenceFlow id="F13ok" sourceRef="Gw_Calidad_AsIs" targetRef="Task_Actualizar_AsIs" name="Correcto" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Actualizar_AsIs" targetRef="Task_Comunicar_AsIs" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Comunicar_AsIs" targetRef="Task_Recibir_AsIs" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Recibir_AsIs" targetRef="End_AsIs" />
  </bpmn:process>
